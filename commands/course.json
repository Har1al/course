{
  "id": "python-foundations-demo",
  "title": "Python · Каталог заданий",
  "demo": true,
  "modules": [
    {
      "title": "Модуль 1 · Старт",
      "lessons": [
        {
          "title": "Первая программа",
          "tasks": [
            {
              "id": "hello-name",
              "title": "Приветствие",
              "statement": "Считайте имя пользователя и выведите строку: Привет, имя!",
              "examples": [
                {
                  "input": "Аня\n",
                  "output": "Привет, Аня!\n"
                }
              ]
            },
            {
              "id": "sum-two",
              "title": "Сумма двух чисел",
              "statement": "Даны два целых числа в одной строке через пробел. Выведите их сумму.",
              "examples": [
                {
                  "input": "8 13\n",
                  "output": "21\n"
                }
              ]
            }
          ]
        },
        {
          "title": "Условия",
          "tasks": [
            {
              "id": "even",
              "title": "Чётное или нечётное",
              "statement": "Выведите ЧЁТНОЕ, если число делится на 2, и НЕЧЁТНОЕ в противном случае.",
              "examples": [
                {
                  "input": "42\n",
                  "output": "ЧЁТНОЕ\n"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "title": "Модуль 2 · Коллекции",
      "lessons": [
        {
          "title": "Строки и списки",
          "tasks": [
            {
              "id": "vowels",
              "title": "Гласные",
              "statement": "Дана строка. Выведите количество русских гласных букв аеёиоуыэюя без учёта регистра.",
              "examples": [
                {
                  "input": "Привет, Python!\n",
                  "output": "2\n"
                }
              ]
            },
            {
              "id": "max-word",
              "title": "Самое длинное слово",
              "statement": "Дана строка слов через пробел. Выведите самое длинное слово. Если вариантов несколько, выведите первое.",
              "examples": [
                {
                  "input": "код должен быть понятным\n",
                  "output": "понятным\n"
                }
              ]
            }
          ]
        },
        {
          "title": "Циклы",
          "tasks": [
            {
              "id": "range-sum",
              "title": "Сумма диапазона",
              "statement": "Даны два целых числа a и b. Выведите сумму всех чисел от a до b включительно.",
              "examples": [
                {
                  "input": "3 7\n",
                  "output": "25\n"
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}